{
  "name": "riven",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "crawlee": "^3.18.2",
    "fastify": "^5.12.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:web": "vite",
    "test": "vitest run",
    "typecheck": "npm run typecheck:web && npm run typecheck:server && npm run typecheck:extension",
    "typecheck:web": "tsc -p web/tsconfig.json",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "build:web": "npm run typecheck:web && vite build",
    "build:extension": "esbuild extension/src/popup.ts --bundle --platform=browser --format=iife --target=chrome120 --outfile=extension/dist/popup.js",
    "typecheck:extension": "tsc -p extension/tsconfig.json"
  }
}
