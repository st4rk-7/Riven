{
  "name": "riven",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fastify/cors": "11.3.1",
    "@fastify/static": "^10.1.7",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "better-auth": "1.7.11",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crawlee": "^3.18.2",
    "fastify": "^5.12.5",
    "lenis": "^1.3.27",
    "lucide-react": "^1.58.0",
    "pg": "8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "tailwindcss-radix": "^4.0.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^24.19.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "dev:web": "vite",
    "test": "vitest run",
    "typecheck": "npm run typecheck:web && npm run typecheck:server && npm run typecheck:extension",
    "typecheck:web": "tsc -p web/tsconfig.json",
    "typecheck:server": "tsc -p server/tsconfig.json",
    "build:web": "npm run typecheck:web && vite build",
    "build:extension": "node scripts/build-extension.mjs",
    "build:extension:live": "node scripts/build-extension.mjs --live",
    "typecheck:extension": "tsc -p extension/tsconfig.json",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "db:check": "node --env-file-if-exists=.env --import tsx scripts/check-database.ts",
    "test:integration": "node --env-file-if-exists=.env scripts/run-integration.mjs",
    "auth:setup": "node scripts/configure-auth.mjs",
    "db:seed": "node --env-file-if-exists=.env --import tsx server/data/run-seed.ts",
    "account:create": "node --env-file-if-exists=.env --import tsx scripts/create-account.ts",
    "crawl": "node --env-file-if-exists=.env --import tsx scripts/run-crawler.ts"
  }
}
