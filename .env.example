# Local development databases only. Percent-encode special characters in passwords.
# Docker Compose initialization. Replace this only in the ignored local .env.
POSTGRES_PASSWORD=YOUR_LOCAL_PASSWORD
# Synthetic local login accounts only. Replace this only in the ignored local .env.
RIVEN_SEED_PASSWORD=YOUR_LOCAL_SEED_PASSWORD
DATABASE_URL=postgresql://postgres:YOUR_ENCODED_PASSWORD@127.0.0.1:5432/riven_dev
TEST_DATABASE_URL=postgresql://postgres:YOUR_ENCODED_PASSWORD@127.0.0.1:5432/riven_test

# Run npm run auth:setup to generate a local secret in .env.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://127.0.0.1:3000
WEB_ORIGIN=http://127.0.0.1:5173
# The Riven extension's fixed ID (from the manifest key).
RIVEN_EXTENSION_ORIGIN=chrome-extension://npehakhmjaahoopfplbjkknaaafcphko
